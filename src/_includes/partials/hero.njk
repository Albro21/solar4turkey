<section id="top" data-dark-hero="true" class="relative flex h-svh min-h-svh flex-col overflow-hidden bg-dark-slate pt-14">
  <!-- Background Video & Overlay -->
  <div class="absolute inset-0">
    <video autoplay muted loop playsinline poster="/assets/img/hero_bg.jpeg" class="absolute inset-0 h-full w-full object-cover object-center" aria-hidden="true">
      <source src="/assets/img/hero-video.mp4" type="video/mp4">
    </video>
    <div class="absolute inset-0 bg-linear-to-t from-black/90 via-black/80 sm:via-30% to-transparent"></div>
  </div>

  <!-- Hero Main Content -->
  <div class="relative z-10 mt-auto flex flex-col items-center px-6 pb-24 text-center">
    
    <!-- Main Heading -->
    <h1 class="mx-auto max-w-5xl text-3xl font-extrabold uppercase tracking-wide text-white md:text-5xl lg:text-6xl mt-5 sm:mt-0">
      {{ hero.title }}
    </h1>

    <!-- Free Offer Heading -->
    <p class="mt-3 text-4xl font-extrabold uppercase tracking-wide text-solar-yellow md:text-6xl">
      {{ hero.free_title }}
    </p>

    <!-- Divider Line -->
    <div class="mt-4 h-px w-full max-w-lg bg-linear-to-r from-transparent via-white/60 to-transparent md:mt-5" aria-hidden="true"></div>

    <!-- Subtitle / Stats -->
    <p class="mt-3 text-lg font-semibold tracking-wide text-white md:text-xl">
      {{ hero.subtitle }}
    </p>

    <!-- Value Proposition -->
    <div class="mt-5 max-w-4xl md:mt-6">
      <p class="min-h-7 text-base font-bold leading-relaxed text-white md:text-lg" aria-live="polite">
        {% for highlight in hero.value_prop_highlights %}
        <span class="inline-block text-solar-yellow transition-all duration-500 ease-out motion-reduce:transition-none" data-value-prop style="{% if not loop.first %}display: none;{% endif %}">{{ highlight }}</span>
        {% endfor %}
      </p>
    </div>

    <!-- Call to Action Buttons -->
    <div class="mt-6 flex flex-wrap items-center justify-center gap-4 md:mt-8">
      <a href="/{{ page.lang | default('en') }}/#audit-form-section" class="inline-flex items-center justify-center gap-2.5 rounded-xl bg-solar-yellow px-8 py-4 text-base font-bold text-dark-slate shadow-[0_0_20px_4px_rgba(250,204,21,0.4)] transition-all duration-300 hover:bg-solar-yellow/90 hover:scale-105 hover:shadow-[0_0_28px_8px_rgba(250,204,21,0.7)]">
        {{ hero.cta_offer }}
        <i class="fa-solid fa-arrow-right h-4 w-4" aria-hidden="true"></i>
      </a>

      <!-- Direct Phone Contact CTA -->
      <a href="tel:+905000000000" class="inline-flex items-center justify-center gap-2.5 rounded-xl bg-white/10 px-8 py-4 text-base font-bold text-white ring-1 ring-white/40 backdrop-blur-md transition-all duration-300 hover:bg-white/20 hover:ring-white">
        <i class="fa-solid fa-phone h-4 w-4 text-solar-yellow" aria-hidden="true"></i>
        +90 500 000 0000
      </a>
    </div>

  </div>

  <!-- Scroll cue -->
  <a href="#zero-investment-model" aria-label="Scroll down to explore our solar solutions" class="absolute bottom-5 left-1/2 z-10 flex -translate-x-1/2 flex-col items-center gap-1 text-white/80 transition-colors duration-200 hover:text-solar-yellow motion-reduce:animate-none">
    <span class="text-[0.65rem] font-bold uppercase tracking-[0.2em] mb-1">{{ hero.scroll }}</span>
    <span class="animate-bounce motion-reduce:animate-none">
      <i class="fa-solid fa-angles-down text-lg" aria-hidden="true"></i>
    </span>
  </a>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const highlights = [...document.querySelectorAll('[data-value-prop]')];
    if (highlights.length < 2) return;

    let currentIndex = 0;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    window.setInterval(() => {
      const current = highlights[currentIndex];
      const nextIndex = (currentIndex + 1) % highlights.length;
      const next = highlights[nextIndex];

      if (!reducedMotion) {
        current.classList.add('opacity-0', 'translate-y-4', 'scale-90');
      }

      window.setTimeout(() => {
        current.style.display = 'none';
        current.classList.remove('opacity-0', 'translate-y-4', 'scale-90');
        next.style.display = 'inline-block';
        if (!reducedMotion) {
          next.classList.add('opacity-0', 'translate-y-4', 'scale-90');
          void next.offsetWidth;
          requestAnimationFrame(() => {
            requestAnimationFrame(() => {
              next.classList.remove('opacity-0', 'translate-y-4', 'scale-90');
            });
          });
        }
        currentIndex = nextIndex;
      }, reducedMotion ? 0 : 500);
    }, 3500);
  });
</script>