<section id="benefits" class="py-20 bg-slate-100 text-slate-900">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-3xl font-extrabold uppercase tracking-wide md:text-4xl text-slate-900">
        {{ benefits.section_title }}
      </h2>
      <div class="mt-4 h-1 w-24 mx-auto rounded-full bg-eco-green-light" aria-hidden="true"></div>
      <p class="mt-4 text-lg text-slate-600">
        {{ benefits.section_subtitle }}
      </p>
    </div>

    <!-- Benefits Grid (2 Columns on Desktop) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {% for item in benefits.list %}
      <div class="flex items-start gap-5 p-6 rounded-2xl bg-white border border-slate-200/80 shadow-xs transition-all duration-300 hover:shadow-md hover:border-eco-green-light/60">
        
        <!-- Dynamic Icon -->
        <div class="shrink-0 p-3.5 rounded-xl bg-eco-green-light/15 text-eco-green">
          <i class="fa-solid {{ item.icon }} h-6 w-6 text-xl leading-none flex items-center justify-center" aria-hidden="true"></i>
        </div>
        
        <!-- Content -->
        <div>
          <h3 class="text-lg font-bold text-slate-900 mb-1.5">
            {{ item.title }}
          </h3>
          <p class="text-sm text-slate-600 leading-relaxed">
            {{ item.description }}
          </p>
        </div>
      </div>
      {% endfor %}
    </div>

  </div>
</section>