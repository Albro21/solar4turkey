{% macro benefit_card(item) %}
  <article class="rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm transition-all duration-300 hover:-translate-y-0.5 hover:border-brand-green/40 hover:shadow-md md:p-6">
    <div class="flex items-start gap-4">
      <i class="fa-solid {{ item.icon }} mt-1 w-5 shrink-0 text-lg text-brand-green" aria-hidden="true"></i>
      <div class="min-w-0 flex-1">
        <div class="flex items-start justify-between gap-3">
          <h3 class="text-base font-bold leading-snug text-slate-900 md:text-lg">{{ item.title }}</h3>
        </div>
        <p class="mt-2 text-sm leading-relaxed text-slate-500 md:text-slate-600">{{ item.description }}</p>
      </div>
    </div>
  </article>
{% endmacro %}

<section id="benefits" class="relative overflow-hidden bg-slate-100 py-16 text-slate-900 md:py-20">
  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <!-- Section Header -->
    <div class="mx-auto mb-10 max-w-3xl text-center md:mb-12">
      <h2 class="text-3xl font-extrabold uppercase tracking-wide text-slate-900 md:text-4xl">
        {{ benefits.section_title }}
      </h2>
      <div class="mx-auto mt-4 h-1 w-24 rounded-full bg-brand-green" aria-hidden="true"></div>
      <p class="mt-4 text-lg text-slate-600">
        {{ benefits.section_subtitle }}
      </p>
    </div>

    <!-- Financial benefit group -->
    <div class="grid gap-6 md:gap-8 lg:grid-cols-[0.9fr_1.35fr] lg:items-start">
      <div class="lg:sticky lg:top-24">
        <h3 class="text-2xl font-bold uppercase leading-tight text-brand-green md:text-3xl">
          {{ benefits.categories.financial }}
        </h3>
        <img src="/assets/img/benefit-1.jpg" alt="{{ benefits.categories.financial }}" class="mt-5 block aspect-[1.8] w-full rounded-2xl object-cover">
      </div>
      <div class="grid gap-3 md:gap-4">
        {% for item in benefits.list %}
          {% if loop.index0 < 5 %}
            {{ benefit_card(item) }}
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <!-- Technical reliability group -->
    <div class="mt-12 grid gap-6 md:mt-16 md:gap-8 lg:grid-cols-[0.9fr_1.35fr] lg:items-start">
      <div class="lg:sticky lg:top-24">
        <h3 class="text-2xl font-bold uppercase leading-tight text-brand-green md:text-3xl">
          {{ benefits.categories.reliability }}
        </h3>
        <img src="/assets/img/benefit-2.jpg" alt="{{ benefits.categories.reliability }}" class="mt-5 block aspect-[1.8] w-full rounded-2xl object-cover">
      </div>
      <div class="grid gap-3 md:gap-4">
        {% for item in benefits.list %}
          {% if loop.index0 >= 5 and loop.index0 < 10 %}
            {{ benefit_card(item) }}
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <!-- Full service and long-term value group -->
    <div class="mt-12 grid gap-6 md:mt-16 md:gap-8 lg:grid-cols-[0.9fr_1.35fr] lg:items-start">
      <div class="lg:sticky lg:top-24">
        <h3 class="text-2xl font-bold uppercase leading-tight text-brand-green md:text-3xl">
          {{ benefits.categories.service }}
        </h3>
        <img src="/assets/img/benefit-3.jpg" alt="{{ benefits.categories.service }}" class="mt-5 block aspect-[1.8] w-full rounded-2xl object-cover">
      </div>
      <div class="grid gap-3 md:gap-4">
        {% for item in benefits.list %}
          {% if loop.index0 >= 10 %}
            {{ benefit_card(item) }}
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>