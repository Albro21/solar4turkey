<section id="audit-form-section" class="relative overflow-hidden bg-slate-100 py-16 text-white md:py-20">
  <div class="relative mx-auto max-w-6xl px-6">
    <!-- Background image and dark overlay -->
    <div class="absolute inset-x-6 inset-y-0 overflow-hidden rounded-[2rem] bg-dark-slate md:inset-x-8">
      <img src="/assets/img/form-bg.png" alt="" class="absolute inset-0 h-full w-full object-cover object-center" aria-hidden="true" />
      {# <div class="absolute inset-0 bg-dark-slate/80"></div> #}
      <div class="absolute inset-0 bg-linear-to-r from-dark-slate to-dark-slate/60"></div>
    </div>

    <div class="relative grid gap-10 px-8 py-10 md:grid-cols-[0.85fr_1.15fr] md:gap-12 md:px-12 md:py-14 lg:items-center lg:px-16">
      <!-- Section Header -->
      <div class="max-w-md">
        <span class="inline-block rounded-full bg-solar-yellow/20 px-4 py-1.5 text-xs font-bold uppercase tracking-widest text-solar-yellow">
          {{ audit.badge }}
        </span>
        <h2 class="mt-4 text-3xl font-extrabold uppercase tracking-wide text-white md:text-4xl">
          {{ audit.section_title }}
        </h2>
        <p class="mt-4 text-base leading-relaxed text-white/75 md:text-lg">
          {{ audit.section_subtitle }}
        </p>
      </div>

      <form onsubmit="event.preventDefault();" class="grid grid-cols-1 gap-x-5 gap-y-4 md:grid-cols-2">
        
        <!-- Full Name -->
        <div class="flex flex-col gap-2">
          <label for="audit-name" class="text-xs font-semibold text-white/90">
            {{ audit.field_name }}
          </label>
          <input type="text" id="audit-name" placeholder="{{ audit.placeholder_name }}" class="h-12 rounded-lg border border-white/20 bg-white px-4 text-sm text-slate-900 placeholder-slate-400 outline-none transition-colors focus:border-solar-yellow focus:ring-2 focus:ring-solar-yellow/40"/>
        </div>

        <!-- Phone Number -->
        <div class="flex flex-col gap-2">
          <label for="audit-phone" class="text-xs font-semibold text-white/90">
            {{ audit.field_phone }}
          </label>
          <input type="tel" id="audit-phone" placeholder="{{ audit.placeholder_phone }}" class="h-12 rounded-lg border border-white/20 bg-white px-4 text-sm text-slate-900 placeholder-slate-400 outline-none transition-colors focus:border-solar-yellow focus:ring-2 focus:ring-solar-yellow/40"/>
        </div>

        <!-- City / Location -->
        <div class="flex flex-col gap-2">
          <label for="audit-city" class="text-xs font-semibold text-white/90">
            {{ audit.field_city }}
          </label>
          <input type="text" id="audit-city" placeholder="{{ audit.placeholder_city }}" class="h-12 rounded-lg border border-white/20 bg-white px-4 text-sm text-slate-900 placeholder-slate-400 outline-none transition-colors focus:border-solar-yellow focus:ring-2 focus:ring-solar-yellow/40"/>
        </div>

        <!-- Monthly Electricity Bill / Consumption -->
        <div class="flex flex-col gap-2">
          <label for="audit-bill" class="text-xs font-semibold text-white/90">
            {{ audit.field_bill }}
          </label>
          <input type="text" id="audit-bill" placeholder="{{ audit.placeholder_bill }}" class="h-12 rounded-lg border border-white/20 bg-white px-4 text-sm text-slate-900 placeholder-slate-400 outline-none transition-colors focus:border-solar-yellow focus:ring-2 focus:ring-solar-yellow/40"/>
        </div>

        <!-- Submit Button (Full Width) -->
        <div class="mt-2 md:col-span-2">
          <button type="submit" class="w-full rounded-lg bg-solar-yellow px-6 py-3.5 text-center text-sm font-bold text-dark-slate transition-colors duration-300 hover:bg-solar-yellow/90 focus:ring-2 focus:ring-solar-yellow focus:outline-none">
            {{ audit.submit_btn }}
          </button>
          <p class="mt-3 text-center text-xs leading-relaxed text-white/60">
            {{ audit.privacy_note }}
          </p>
        </div>

      </form>
    </div>

  </div>
</section>