<section id="getting-started" class="relative z-10 overflow-x-clip bg-slate-100 py-20 md:py-24">
  <div class="relative mx-auto max-w-6xl px-6">

    <!-- Header -->
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="text-3xl font-extrabold tracking-tight text-dark-slate md:text-4xl">
        <span class="text-brand-green">{{ onboarding.title_prefix }}</span>
        {{ onboarding.title_highlight }}
      </h2>
      <div class="mx-auto mt-4 h-1 w-24 rounded-full bg-brand-green" aria-hidden="true"></div>
      <p class="mt-4 text-lg leading-relaxed text-slate-600 md:text-lg">
        {{ onboarding.subtitle }}
      </p>
    </div>

    <!-- Grid: cards on the sides, image in the centre (desktop) -->
    <div class="mt-12 grid gap-6 lg:mt-16 lg:grid-cols-[0.9fr_1.6fr_0.9fr] lg:grid-rows-[auto_auto] lg:gap-x-10 lg:gap-y-6">

      {% set placements = [
        "lg:col-start-1 lg:row-start-1",
        "lg:col-start-1 lg:row-start-2",
        "lg:col-start-3 lg:row-start-1",
        "lg:col-start-3 lg:row-start-2"
      ] %}

      <!-- Centre image with connector lines -->
      <div class="relative order-first flex items-center justify-center lg:order-0 lg:col-start-2 lg:row-span-2 lg:row-start-1">
        <img src="/assets/img/onboarding.png" alt="" loading="lazy" class="relative z-10 w-full max-w-2xl" >

        <!-- Vertical connectors behind the image -->
        <span class="absolute left-[30%] top-[12%] z-0 hidden h-[76%] w-px bg-brand-green/40 lg:block" aria-hidden="true"></span>
        <span class="absolute right-[30%] top-[12%] z-0 hidden h-[76%] w-px bg-brand-green/40 lg:block" aria-hidden="true"></span>

        <!-- Top-left connector -->
        <span class="absolute left-0 top-[12%] hidden h-px w-[30%] bg-brand-green/40 lg:block" aria-hidden="true"></span>
        <span class="absolute left-0 top-[12%] hidden h-2.5 w-2.5 -translate-x-1/2 -translate-y-1/2 rounded-full bg-solar-yellow lg:block" aria-hidden="true"></span>

        <!-- Top-right connector -->
        <span class="absolute right-0 top-[12%] hidden h-px w-[30%] bg-brand-green/40 lg:block" aria-hidden="true"></span>
        <span class="absolute right-0 top-[12%] hidden h-2.5 w-2.5 translate-x-1/2 -translate-y-1/2 rounded-full bg-solar-yellow lg:block" aria-hidden="true"></span>

        <!-- Bottom-left connector -->
        <span class="absolute left-0 top-[88%] hidden h-px w-[30%] bg-brand-green/40 lg:block" aria-hidden="true"></span>
        <span class="absolute left-0 top-[88%] hidden h-2.5 w-2.5 -translate-x-1/2 -translate-y-1/2 rounded-full bg-solar-yellow lg:block" aria-hidden="true"></span>

        <!-- Bottom-right connector -->
        <span class="absolute right-0 top-[88%] hidden h-px w-[30%] bg-brand-green/40 lg:block" aria-hidden="true"></span>
        <span class="absolute right-0 top-[88%] hidden h-2.5 w-2.5 translate-x-1/2 -translate-y-1/2 rounded-full bg-solar-yellow lg:block" aria-hidden="true"></span>
      </div>

      <!-- Step cards -->
      {% for step in onboarding.steps %}
        <article class="group relative ml-12 flex flex-col rounded-2xl border-2 border-brand-green bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl lg:ml-0 before:absolute before:-left-9 before:-top-6 before:-bottom-6 before:w-0 before:border-l-2 before:border-dashed before:border-brand-green/40 before:content-[''] last:before:bottom-0 lg:before:hidden {{ placements[loop.index0] }}">

          <!-- Mobile: dot and horizontal stub linking the rail to the card -->
          <span class="absolute -left-9 top-12 z-10 h-2.5 w-2.5 -translate-x-1/2 -translate-y-1/2 rounded-full bg-solar-yellow lg:hidden" aria-hidden="true"></span>
          <span class="absolute -left-9 top-12 h-px w-9 -translate-y-1/2 bg-brand-green/40 lg:hidden" aria-hidden="true"></span>

          <span class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-brand-green text-lg font-extrabold text-white">
            {{ loop.index }}
          </span>
          <h3 class="mt-8 text-xl font-bold leading-snug text-dark-slate">
            {{ step.title }}
          </h3>
          <p class="mt-3 text-base leading-relaxed text-slate-600">
            {{ step.description }}
          </p>
        </article>
      {% endfor %}

    </div>
  </div>
</section>