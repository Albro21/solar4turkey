<section id="getting-started" class="relative z-10 overflow-x-clip overflow-y-visible bg-slate-100 py-20 md:py-24">
  <!-- Subtle Background Decorative Glows -->
  <div class="pointer-events-none absolute -left-20 -top-20 z-0 h-72 w-72 rounded-full bg-solar-yellow/15 blur-3xl" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -right-20 -bottom-20 z-0 h-72 w-72 rounded-full bg-solar-yellow/15 blur-3xl" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-6xl px-6">
    <!-- Header -->
    <div class="relative z-10 mx-auto max-w-3xl text-center">
      <h2 class="text-3xl font-extrabold uppercase tracking-wide text-dark-slate md:text-4xl">
        {{ onboarding.title }}
      </h2>
      <div class="mx-auto mt-4 h-1 w-24 rounded-full bg-solar-yellow" aria-hidden="true"></div>
      <p class="mt-4 text-lg leading-relaxed text-slate-600">
        {{ onboarding.subtitle }}
      </p>
    </div>

    <!-- Roadmap Timeline Container -->
    <div class="relative z-10 mt-12 md:mt-16">

      <!-- Desktop Connecting Line (Dashed axis behind badges) -->
      <div class="pointer-events-none absolute top-8 left-10 right-10 hidden h-0.5 border-t-2 border-dashed border-slate-300 lg:block" aria-hidden="true"></div>

      <!-- Mobile Connecting Line (Dashed axis behind badges) -->
      <div class="pointer-events-none absolute top-6 bottom-6 left-6 w-0.5 border-l-2 border-dashed border-slate-300 lg:hidden" aria-hidden="true"></div>

      <div class="grid gap-8 lg:grid-cols-4 lg:gap-6">
        {% for step in onboarding.steps %}
        <article class="group relative flex min-w-0 flex-col items-start">
          
          <!-- Step Header Node & Arrow Connector -->
          <div class="relative flex w-full items-center justify-between">
            <!-- Step Number Badge / Milestone Node -->
            <div class="relative z-10 flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-solar-yellow text-dark-slate font-extrabold text-lg shadow-md transition-all duration-300 group-hover:scale-110 group-hover:ring-4 group-hover:ring-solar-yellow/30 lg:h-16 lg:w-16 lg:text-xl">
              {{ loop.index }}
            </div>

            <!-- Horizontal Arrow Connector for Desktop (Hidden on last step) -->
            {% if not loop.last %}
            <div class="hidden flex-1 items-center justify-center px-3 lg:flex" aria-hidden="true">
              <div class="flex w-full items-center gap-1 text-slate-400">
                <span class="h-0.5 w-full bg-slate-300 transition-colors duration-300 group-hover:bg-solar-yellow"></span>
                <i class="fa-solid fa-chevron-right text-xs transition-transform duration-300 group-hover:translate-x-1.5 group-hover:text-solar-yellow"></i>
              </div>
            </div>
            {% endif %}
          </div>

          <!-- Content Card -->
          <div class="mt-4 ml-16 w-auto flex-1 rounded-2xl border border-slate-200/90 bg-white p-6 shadow-xs transition-all duration-300 group-hover:-translate-y-1.5 group-hover:border-solar-yellow/80 group-hover:shadow-xl lg:ml-0 lg:mt-6 lg:w-full">
            
            <!-- Icon & Step Watermark -->
            <div class="flex items-center justify-between">
              <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-solar-yellow/15 text-amber-700 transition-colors duration-300 group-hover:bg-solar-yellow/20">
                <i class="fa-solid {{ step.icon }} text-base" aria-hidden="true"></i>
              </span>
              <span class="text-xs font-extrabold uppercase tracking-widest text-slate-400 transition-colors duration-300 group-hover:text-solar-yellow">
                0{{ loop.index }}
              </span>
            </div>

            <h3 class="mt-4 text-lg font-bold leading-snug text-dark-slate">
              {{ step.title }}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">
              {{ step.description }}
            </p>
          </div>

        </article>
        {% endfor %}
      </div>
    </div>
  </div>
</section>