<!-- Tariff Growth Section -->
<section id="tariff-growth" class="relative overflow-hidden bg-slate-100 py-20 text-slate-900">
  <!-- Subtle Background Decorative Glows -->
  <div class="pointer-events-none absolute -left-24 top-16 h-80 w-80 rounded-full bg-eco-green/10 blur-3xl" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -right-24 bottom-16 h-80 w-80 rounded-full bg-eco-green-light/10 blur-3xl" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-6xl px-6">
    
    <!-- Section Header -->
    <div class="mx-auto mb-12 max-w-3xl text-center">
      <h2 class="mt-2 text-3xl font-extrabold uppercase tracking-wide text-dark-slate md:text-4xl">
        {{ tariffGrowth.title }}
      </h2>
      <div class="mx-auto mt-4 h-1 w-24 rounded-full bg-brand-red" aria-hidden="true"></div>
      <p class="mt-4 text-base leading-relaxed text-slate-600 md:text-lg">
        {{ tariffGrowth.descriptionBefore }} <span class="font-bold text-brand-red">{{ tariffGrowth.multiplier }}</span>.
      </p>
    </div>

    <!-- Grid Container -->
    <div class="grid grid-cols-1 items-stretch gap-8 lg:grid-cols-3">
      
      <!-- Interactive Chart (2 Columns Wide on desktop) -->
      <div class="min-w-0 rounded-2xl border border-slate-200 bg-white p-6 shadow-md lg:col-span-2 md:p-8">
        <div class="mb-6 flex flex-col items-start gap-3 sm:flex-row sm:items-center sm:justify-between">
          <h3 class="text-lg font-bold text-dark-slate">{{ tariffGrowth.chartTitle }}</h3>
          <span class="shrink-0 rounded-full border border-eco-green/40 bg-eco-green/10 px-3 py-1 text-xs font-bold text-black">
            {{ tariffGrowth.period }}
          </span>
        </div>
        
        <!-- Canvas Container -->
        <div class="relative h-72 min-h-72 w-full md:h-80 md:min-h-80">
          <canvas id="tariffChart" class="block h-full w-full"></canvas>
        </div>
      </div>

      <!-- Key Insights & Takeaways (1 Column Wide) -->
      <div class="flex min-w-0 flex-col justify-center gap-6">
        <div class="rounded-2xl border border-red-300 bg-red-50 p-6 shadow-xs">
          <div class="mb-2 flex items-center gap-3">
            <i class="fa-solid fa-arrow-trend-up text-xl text-red-600"></i>
            <h4 class="font-bold text-dark-slate">{{ tariffGrowth.insightTitle }}</h4>
          </div>
          <p class="text-sm leading-relaxed text-slate-700">
            {{ tariffGrowth.insightDescription }}
          </p>
        </div>

        <div class="rounded-2xl border border-eco-green/40 bg-eco-green/10 p-6">
          <div class="mb-2 flex items-center gap-3">
            <i class="fa-solid fa-shield-halved text-xl text-eco-green"></i>
            <h4 class="font-bold text-dark-slate">{{ tariffGrowth.solutionTitle }}</h4>
          </div>
          <p class="text-sm leading-relaxed text-slate-700">
            {{ tariffGrowth.solutionDescription }}
          </p>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- Include Chart.js CDN -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<!-- Chart Initialization Script -->
<script>
  document.addEventListener("DOMContentLoaded", function () {
    const chartCanvas = document.getElementById('tariffChart');
    if (!chartCanvas || typeof Chart === 'undefined') return;
    const ctx = chartCanvas.getContext('2d');

    // Use one color per year to show the progression from lower to higher tariffs.
    const barColors = [
      '#34A853', '#4CAF50', '#66BB6A', '#8BC34A',
      '#A2D032', '#C0CA33', '#D4C62A', '#E0B52A',
      '#E89B2A', '#EF7D2A', '#F05A28', '#DC2626'
    ];

    new Chart(ctx, {
      type: 'bar',
      data: {
        labels: ['2015', '2016', '2017', '2018', '2019', '2020', '2021', '2022', '2023', '2024', '2025', '2026'],
        datasets: [{
          label: '{{ tariffGrowth.chartLabel }}',
          data: [0.38, 0.42, 0.48, 0.70, 0.90, 1.00, 1.35, 2.85, 3.85, 4.75, 5.25, 5.75], // Midpoint values from PDF
          backgroundColor: barColors,
          borderRadius: 6,
          borderSkipped: false,
          hoverBackgroundColor: barColors
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            display: false
          },
          tooltip: {
            backgroundColor: '#FFFFFF',
            titleColor: '#0F172A',
            bodyColor: '#34A853',
            borderColor: '#CBD5E1',
            borderWidth: 1,
            padding: 12,
            displayColors: false,
            callbacks: {
              label: function(context) {
                return `{{ tariffGrowth.tooltipLabel }}: ~${context.parsed.y} TRY / kWh`;
              }
            }
          }
        },
        scales: {
          x: {
            grid: {
              display: false,
              drawBorder: false
            },
            ticks: {
              color: '#475569',
              font: { size: 12 }
            }
          },
          y: {
            grid: {
              color: 'rgba(15, 23, 42, 0.08)',
              drawBorder: false
            },
            ticks: {
              color: '#475569',
              font: { size: 12 },
              callback: function(value) {
                return value + ' ₺';
              }
            }
          }
        }
      }
    });
  });
</script>