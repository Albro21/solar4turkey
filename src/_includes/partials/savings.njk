<section id="how-it-works" class="relative overflow-hidden bg-slate-100 py-14 md:py-16">
  <!-- Subtle Background Glow -->
  <span class="pointer-events-none absolute -right-40 top-10 h-96 w-96 rounded-full bg-eco-green-light/10 blur-[120px]" aria-hidden="true"></span>

  <div class="relative mx-auto w-full max-w-[100rem] px-6">
    <!-- Section Title -->
    <div class="mx-auto mb-10 max-w-4xl text-center md:mb-12">
      <h2 class="text-[clamp(1.7rem,1.2rem+1.21vw,2.5rem)] font-bold leading-[1.08] tracking-tight text-slate-900">
        {{ savings.title }}
      </h2>
      <div class="mt-4 h-1 w-24 mx-auto rounded-full bg-eco-green-light" aria-hidden="true"></div>
    </div>

    <!-- 3-Column Interactive Grid -->
    <div class="grid items-center gap-5 lg:grid-cols-[minmax(230px,0.62fr)_1.75fr_minmax(230px,0.62fr)] lg:gap-6">

      <!-- Day Phase Card (Left Column - Original Bright Style) -->
      <div class="relative lg:order-1">
        <button id="btn-day" type="button" onclick="setPhase('day')" class="w-full cursor-pointer rounded-3xl border border-amber-400/70 bg-amber-300 p-6 text-left shadow-[0_16px_44px_rgba(251,191,36,0.35)] transition-all duration-500 hover:opacity-100 lg:p-8">
          <div class="flex items-center gap-3">
            <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-white/50 text-amber-700">
              <i class="fa-solid fa-sun text-xl leading-none" aria-hidden="true"></i>
            </span>
            <span class="text-[1.25rem] font-bold tracking-tight text-slate-900 lg:text-[1.5rem]">{{ savings.day.title }}</span>
          </div>
          <p class="mt-3 text-[0.92rem] leading-relaxed text-slate-900/80 lg:mt-4 lg:text-[1.05rem]">
            {{ savings.day.desc }}
          </p>
          <div class="mt-4 h-1 overflow-hidden rounded-full bg-slate-900/10">
            <span id="bar-day" class="block h-full w-full origin-left rounded-full bg-eco-green transition-transform duration-500" style="transform: scaleX(1);"></span>
          </div>
        </button>
      </div>

      <!-- Center Diagram Display (Center Column) -->
      <div class="pointer-events-none lg:order-2">
        <div class="relative w-full" style="aspect-ratio: 4 / 3;">
          <!-- Transparent Diagram Images -->
          <img id="img-day" alt="Multistorey solar system diagram - Daytime flow" decoding="async" class="absolute inset-0 h-full w-full object-contain transition-opacity duration-700" src="/assets/img/diagram_daytime_transparent.png" />
          <img id="img-night" alt="Multistorey solar system diagram - Nighttime battery flow" decoding="async" class="absolute inset-0 h-full w-full object-contain opacity-0 transition-opacity duration-700" src="/assets/img/diagram_nighttime_transparent.png" />
        </div>
      </div>

      <!-- Night Phase Card (Right Column - Original Dark Style) -->
      <div class="relative lg:order-3">
        <button id="btn-night" type="button" onclick="setPhase('night')" class="w-full cursor-pointer rounded-3xl border border-slate-700 bg-slate-900 p-6 text-left opacity-75 transition-all duration-500 hover:opacity-100 lg:p-8">
          <div class="flex items-center gap-3">
            <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-white/10 text-eco-green-light">
              <i class="fa-solid fa-moon text-xl leading-none" aria-hidden="true"></i>
            </span>
            <span class="text-[1.25rem] font-bold tracking-tight text-white lg:text-[1.5rem]">{{ savings.night.title }}</span>
          </div>
          <p class="mt-3 text-[0.92rem] leading-relaxed text-white/75 lg:mt-4 lg:text-[1.05rem]">
            {{ savings.night.desc }}
          </p>
          <div class="mt-4 h-1 overflow-hidden rounded-full bg-white/15">
            <span id="bar-night" class="block h-full w-full origin-left rounded-full bg-eco-green-light transition-transform duration-500" style="transform: scaleX(0);"></span>
          </div>
        </button>
      </div>

    </div>

    <!-- Savings Calculator Section -->
    <div class="mx-auto mt-12 max-w-4xl">
      <!-- System Size Toggle -->
      <div class="flex justify-center">
        <div class="inline-flex rounded-full bg-slate-200/80 p-1.5 ring-1 ring-slate-300" role="group" aria-label="System Capacity">
          <button type="button" onclick="setCapacity(6)" id="kw-6" class="kw-btn rounded-full px-5 py-2 text-[0.9rem] font-bold text-slate-700 transition-colors duration-300 md:px-6 hover:text-slate-900">6 kW</button>
          <button type="button" onclick="setCapacity(8)" id="kw-8" class="kw-btn rounded-full px-5 py-2 text-[0.9rem] font-bold text-slate-700 transition-colors duration-300 md:px-6 hover:text-slate-900">8 kW</button>
          <button type="button" onclick="setCapacity(10)" id="kw-10" class="kw-btn active rounded-full bg-eco-green-light px-5 py-2 text-[0.9rem] font-bold text-slate-900 shadow-[0_6px_18px_rgba(162,208,50,0.35)] transition-colors duration-300 md:px-6">10 kW</button>
          <button type="button" onclick="setCapacity(12)" id="kw-12" class="kw-btn rounded-full px-5 py-2 text-[0.9rem] font-bold text-slate-700 transition-colors duration-300 md:px-6">12 kW</button>
        </div>
      </div>

      <!-- Financial Calculations Output Grid (Styled like benefits cards) -->
      <div class="mt-6 grid gap-6 sm:grid-cols-3">
        
        <!-- Daily Savings Card -->
        <div class="flex h-full flex-col items-center justify-between gap-2 rounded-2xl bg-white p-6 text-center border border-slate-200/80 shadow-xs transition-all duration-300 hover:shadow-md hover:border-eco-green-light/60">
          <span class="text-[0.75rem] font-semibold uppercase tracking-wider text-slate-500">{{ savings.calc.dailyLabel }}</span>
          <span id="save-daily" class="text-[2.2rem] font-extrabold leading-none tracking-tight text-eco-green md:text-[2.5rem]">₺385</span>
          <span class="text-[0.95rem] text-slate-600">{{ savings.calc.dailySub }}</span>
        </div>

        <!-- Monthly Savings Card -->
        <div class="flex h-full flex-col items-center justify-between gap-2 rounded-2xl bg-white p-6 text-center border border-slate-200/80 shadow-xs transition-all duration-300 hover:shadow-md hover:border-eco-green-light/60">
          <span class="text-[0.75rem] font-semibold uppercase tracking-wider text-slate-500">{{ savings.calc.monthlyLabel }}</span>
          <span id="save-monthly" class="text-[2.2rem] font-extrabold leading-none tracking-tight text-eco-green md:text-[2.5rem]">₺11,550</span>
          <span class="text-[0.95rem] text-slate-600">{{ savings.calc.monthlySub }}</span>
        </div>

        <!-- Annual Savings Card -->
        <div class="flex h-full flex-col items-center justify-between gap-2 rounded-2xl bg-white p-6 text-center border border-slate-200/80 shadow-xs transition-all duration-300 hover:shadow-md hover:border-eco-green-light/60">
          <span class="text-[0.75rem] font-semibold uppercase tracking-wider text-slate-500">{{ savings.calc.annualLabel }}</span>
          <span id="save-annual" class="text-[2.2rem] font-extrabold leading-none tracking-tight text-eco-green md:text-[2.5rem]">₺83,200</span>
          <span class="text-[0.95rem] text-slate-600">{{ savings.calc.annualSub }}</span>
        </div>

      </div>

      <!-- Legal Disclaimer -->
      <p class="mt-6 text-center text-[0.9rem] leading-relaxed text-slate-500">
        {{ savings.disclaimer }}
      </p>
    </div>
  </div>
</section>

<!-- Interactive Logic JS -->
<script>
  const kwData = {
    6: {
      daily: "₺230",
      monthly: "₺6,930",
      annual: "₺49,900"
    },
    8: {
      daily: "₺308",
      monthly: "₺9,240",
      annual: "₺66,500"
    },
    10: {
      daily: "₺385",
      monthly: "₺11,550",
      annual: "₺83,200"
    },
    12: {
      daily: "₺462",
      monthly: "₺13,860",
      annual: "₺99,800"
    }
  };

  function setCapacity(kw) {
    document
      .querySelectorAll('.kw-btn')
      .forEach(btn => {
        btn.className = "kw-btn rounded-full px-5 py-2 text-[0.9rem] font-bold text-slate-700 transition-colors duration-300 md:px-6 hover:text-slate-900";
      });
    const selectedBtn = document.getElementById(`kw-${kw}`);
    if (selectedBtn) {
      selectedBtn.className = "kw-btn active rounded-full bg-eco-green-light px-5 py-2 text-[0.9rem] font-bold text-slate-900 shadow-[0_6px_18px_rgba(162,208,50,0.35)] transition-colors duration-300 md:px-6";
    }

    document.getElementById('save-daily').innerText = kwData[kw].daily;
    document.getElementById('save-monthly').innerText = kwData[kw].monthly;
    document.getElementById('save-annual').innerText = kwData[kw].annual;
  }

  function setPhase(phase) {
    const btnDay = document.getElementById('btn-day');
    const btnNight = document.getElementById('btn-night');
    const barDay = document.getElementById('bar-day');
    const barNight = document.getElementById('bar-night');

    const imgDay = document.getElementById('img-day');
    const imgNight = document.getElementById('img-night');

    if (phase === 'day') {
      btnDay.className = "w-full cursor-pointer rounded-3xl border border-amber-400/70 bg-amber-300 p-6 text-left shadow-[0_16px_44px_rgba(251,191,36,0.35)] opacity-100 transition-all duration-500 lg:p-8";
      btnNight.className = "w-full cursor-pointer rounded-3xl border border-slate-700 bg-slate-900 p-6 text-left opacity-75 transition-all duration-500 hover:opacity-100 lg:p-8";
      barDay.style.transform = "scaleX(1)";
      barNight.style.transform = "scaleX(0)";

      imgDay.style.opacity = "1";
      imgNight.style.opacity = "0";
    } else {
      btnDay.className = "w-full cursor-pointer rounded-3xl border border-amber-400/70 bg-amber-300 p-6 text-left opacity-75 transition-all duration-500 hover:opacity-100 lg:p-8";
      btnNight.className = "w-full cursor-pointer rounded-3xl border border-slate-700 bg-slate-900 p-6 text-left shadow-[0_16px_44px_rgba(6,28,51,0.4)] opacity-100 transition-all duration-500 lg:p-8";
      barDay.style.transform = "scaleX(0)";
      barNight.style.transform = "scaleX(1)";

      imgDay.style.opacity = "0";
      imgNight.style.opacity = "1";
    }
  }
</script>