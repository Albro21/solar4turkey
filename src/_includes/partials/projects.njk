<section id="projects" class="relative scroll-mt-16 py-14 md:py-16 bg-slate-100">
  <!-- Section Header -->
  <div class="mx-auto mb-8 max-w-6xl px-6 text-center md:mb-10">
    <h2 class="text-[clamp(1.7rem,1.2rem+1.21vw,2.5rem)] font-extrabold tracking-tight text-dark-slate">
      {{ projects.section_title }}
    </h2>
    <div class="mx-auto mt-4 h-1 w-24 rounded-full bg-solar-yellow" aria-hidden="true"></div>
    <p class="mx-auto mt-3 max-w-2xl text-[clamp(0.98rem,0.9rem+0.3vw,1.15rem)] leading-relaxed text-gray-600">
      {{ projects.section_subtitle }}
    </p>
  </div>

  {% set currentLang = page.lang | default('en') %}
  {% for category in projects.categories %}
  <div class="mt-16 first:mt-0 md:mt-24">
    <h3 class="mx-auto mb-8 max-w-6xl px-6 text-center text-2xl font-bold text-dark-slate md:mb-10 md:text-3xl">{{ category.title }}</h3>

    <!-- Projects Horizontal Scroll Container -->
    <div class="relative w-full">
      <div id="projects-carousel-{{ category.id }}" data-project-carousel class="flex snap-x snap-mandatory gap-6 overflow-x-auto px-3 scroll-px-3 scroll-smooth scrollbar-none md:px-7 md:scroll-px-7 lg:px-13 lg:scroll-px-13 [&::-webkit-scrollbar]:hidden" role="region" aria-label="{{ category.title }}">

      {% for project in self[currentLang].projects.list or projects.list %}
        <div class="project-card-shell flex min-h-112 w-[88%] shrink-0 snap-start sm:w-[72%] md:min-h-136 lg:w-[calc((100%-48px)/3)]">
        <article class="project-card group relative flex min-h-112 w-full flex-col overflow-hidden rounded-4xl bg-dark-slate transition-all duration-300 hover:border-4 hover:border-solar-yellow md:min-h-136 border-l-6 border-solar-yellow">

          <!-- Background image -->
          <div class="absolute inset-0 overflow-hidden">
            <img src="{{ project.image }}" alt="{{ project.title }}"
                class="h-full w-full object-cover object-center transition-transform duration-300 group-hover:scale-103"
                loading="lazy" />
          </div>

          <!-- Left-to-right gradient for text legibility -->
          <div class="pointer-events-none absolute inset-0 bg-linear-to-r from-black/90 via-dark-slate/80" aria-hidden="true"></div>

          <!-- Location badge -->
          <div class="relative p-7 md:p-10">
            <span class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-dark-slate/40 px-4 py-1.5 text-[0.8rem] font-semibold text-solar-yellow backdrop-blur-md">
              <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
              {{ project.location }}
            </span>
          </div>

          <!-- Bottom content -->
          <div class="relative mt-auto flex flex-col gap-5 p-7 pt-0 md:p-10 md:pt-0">

            <!-- Title and system output -->
            <div>
              <h3 class="text-[1.9rem] font-extrabold leading-tight text-white md:text-[2.4rem]">
                {{ project.title }}
              </h3>
              <p class="mt-1.5 text-[0.95rem] font-semibold text-solar-yellow md:text-[1.05rem]">
                {{ project.output }}
              </p>
            </div>

            <!-- Savings: short accent bar -->
            <div>
              <span class="mb-4 block h-0.5 w-24 rounded-full bg-solar-yellow" aria-hidden="true"></span>
              <p class="text-[0.72rem] font-semibold uppercase tracking-wider text-white/60">
                {{ projects.savings_label }}
              </p>
              <p class="mt-1 text-[2rem] font-extrabold leading-none text-white md:text-[2.4rem]">
                {{ project.savings }}
              </p>
            </div>

            <!-- Configuration and specs -->
            <div>
              <p class="text-[0.9rem] font-medium text-white/85">
                {{ project.configuration }}
              </p>
              <div class="mt-3 flex flex-wrap gap-2">
                {% for spec in project.specs_list %}
                <span class="rounded-full border border-white/15 bg-white/10 px-3 py-1 text-[0.75rem] text-white/85 backdrop-blur-sm">
                  {{ spec }}
                </span>
                {% endfor %}
              </div>
            </div>

            <!-- Buttons: yellow primary, solid white secondary -->
            <div class="flex flex-wrap items-center gap-3">
              <a href="/{{ page.lang | default('en') }}/?project={{ project.id }}#audit-form-section"
                class="rounded-xl bg-solar-yellow px-6 py-3 text-center text-sm font-bold text-dark-slate transition-colors duration-300 hover:bg-solar-yellow/90">
                {{ projects.cta_proposal }}
              </a>
              <a href="/{{ page.lang | default('en') }}/projects/{{ project.id }}"
                class="rounded-xl bg-white px-6 py-3 text-center text-sm font-bold text-dark-slate transition-colors duration-300 hover:bg-white/90">
                {{ projects.cta_view }}
              </a>
            </div>
          </div>
        </article>
        </div>
      {% endfor %}

      </div>
    </div>

    <!-- Carousel Indicator Controls -->
    <div class="mt-4 flex items-center justify-center gap-2">
      <button type="button" data-project-prev aria-label="Previous project" class="hidden h-10 w-10 place-items-center rounded-full bg-solar-yellow text-dark-slate ring-1 ring-gray-300 opacity-40 transition-all duration-200 hover:bg-solar-yellow/90 disabled:bg-solar-yellow/40 disabled:opacity-50 disabled:cursor-not-allowed md:grid">
        <i class="fa-solid fa-arrow-right flex h-5 w-5 items-center justify-center leading-none rotate-180" aria-hidden="true"></i>
      </button>
      <div data-project-dots class="flex justify-center gap-1.5"></div>
      <button type="button" data-project-next aria-label="Next project" class="hidden h-10 w-10 place-items-center rounded-full bg-solar-yellow text-dark-slate ring-1 ring-gray-300 transition-all duration-200 hover:bg-solar-yellow/90 disabled:bg-solar-yellow/40 disabled:opacity-50 disabled:cursor-not-allowed md:grid">
        <i class="fa-solid fa-arrow-right flex h-5 w-5 items-center justify-center leading-none" aria-hidden="true"></i>
      </button>
    </div>
  </div>
  {% endfor %}

  <!-- Footnote Clarification -->
  <div class="mx-auto max-w-6xl px-6">
    <p class="mt-6 text-center text-sm leading-relaxed text-gray-500">
      {{ projects.footnote }}
    </p>
  </div>
</section>

<!-- Carousel Script -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('[data-project-carousel]').forEach((carousel) => {
      const cards = carousel.querySelectorAll('.project-card');
      const controls = carousel.parentElement.nextElementSibling;
      const prevBtn = controls?.querySelector('[data-project-prev]');
      const nextBtn = controls?.querySelector('[data-project-next]');
      const dotsContainer = controls?.querySelector('[data-project-dots]');

      if (!cards.length || !dotsContainer) return;

      cards.forEach((_, idx) => {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.ariaLabel = `Go to project ${idx + 1}`;
        dot.className = `h-2.5 rounded-full transition-all duration-300 ${idx === 0 ? 'w-6 bg-solar-yellow ring-1 ring-dark-slate/20' : 'w-2.5 bg-gray-300 hover:bg-gray-400'}`;
        dot.addEventListener('click', () => {
          const card = cards[idx];
          carousel.scrollTo({ left: card.offsetLeft - carousel.offsetLeft, behavior: 'smooth' });
        });
        dotsContainer.appendChild(dot);
      });

      const dots = dotsContainer.querySelectorAll('button');
      const updateActiveState = () => {
        const scrollLeft = carousel.scrollLeft;
        let activeIndex = 0;
        let minDistance = Infinity;

        cards.forEach((card, index) => {
          const distance = Math.abs(card.offsetLeft - carousel.offsetLeft - scrollLeft);
          if (distance < minDistance) {
            minDistance = distance;
            activeIndex = index;
          }
        });

        dots.forEach((dot, idx) => {
          dot.className = idx === activeIndex
            ? 'h-2.5 w-6 rounded-full bg-solar-yellow ring-1 ring-dark-slate/20 transition-all duration-300'
            : 'h-2.5 w-2.5 rounded-full bg-gray-300 hover:bg-gray-400 transition-all duration-300';
        });

        const maxScroll = carousel.scrollWidth - carousel.clientWidth;
        if (prevBtn) {
          prevBtn.disabled = scrollLeft <= 10;
          prevBtn.classList.toggle('opacity-40', prevBtn.disabled);
        }
        if (nextBtn) {
          nextBtn.disabled = scrollLeft >= maxScroll - 10;
          nextBtn.classList.toggle('opacity-40', nextBtn.disabled);
        }
      };

      prevBtn?.addEventListener('click', () => {
        carousel.scrollBy({ left: -(cards[0].offsetWidth + 24), behavior: 'smooth' });
      });
      nextBtn?.addEventListener('click', () => {
        carousel.scrollBy({ left: cards[0].offsetWidth + 24, behavior: 'smooth' });
      });
      carousel.addEventListener('scroll', updateActiveState, { passive: true });
      updateActiveState();
    });
  });
</script>