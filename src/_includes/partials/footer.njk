<!-- Footer Section -->
<footer class="relative overflow-hidden bg-dark-slate pt-10 md:pt-20">

  <!-- Dark Gradient Overlay -->
  <div class="absolute inset-0 bg-linear-to-b from-dark-slate/90 via-dark-slate/95 to-dark-slate" aria-hidden="true"></div>

  <!-- Top Accent Border (Brand Red to Yellow Gradient) -->
  <span class="absolute inset-x-0 top-0 h-px bg-linear-to-r from-transparent via-amber-700/60 to-transparent" aria-hidden="true"></span>

  <!-- Subtle Glowing Light Blur in Center-Top -->
  <span class="pointer-events-none absolute -top-40 left-1/2 h-90 w-160 -translate-x-1/2 rounded-full bg-solar-blue/20 blur-[110px]" aria-hidden="true"></span>

  <div class="relative mx-auto max-w-6xl px-5 md:px-6">
    <div class="grid gap-8 md:gap-12 lg:grid-cols-3 lg:gap-10">

      <!-- Column 1: Brand Info, Description, Socials & CTA Button -->
      <div class="flex flex-col justify-between">
        <div>
          <!-- Logo Image & Logo Text Images -->
          <a class="group inline-flex items-center gap-2" aria-label="Solar4Turkey — Homepage" href="{{ homeUrl | default('/') }}">
            <img src="/assets/img/logo_small_transparent.png" alt="Solar4Turkey Logo" class="h-7 w-auto object-contain transition-transform duration-300 group-hover:scale-105 md:h-8 sm:h-9"/>
            <img src="/assets/img/logo_text_transparent.png" alt="Solar4Turkey" class="h-5 w-auto object-contain md:h-6 sm:h-7"/>
          </a>
          <p class="mt-3 max-w-[34ch] text-sm leading-relaxed text-white/80 md:mt-5 md:text-[0.95rem]">
            {{ footer.description }}
          </p>
        </div>

        <div class="mt-5 flex flex-col items-start gap-4 md:mt-8 md:gap-6">
          <!-- Get Free Audit Button -->
          <a href="{{ homeUrl }}#audit-form-section" class="inline-flex items-center justify-center rounded-lg bg-solar-yellow px-4 py-2.5 text-xs font-bold text-dark-slate shadow-lg transition-all duration-300 hover:bg-solar-yellow/90 hover:shadow-solar-yellow/20 focus:ring-2 focus:ring-solar-yellow focus:outline-none md:rounded-xl md:px-6 md:py-3 md:text-sm">
            {{ footer.cta }}
          </a>

          <!-- Social Links -->
          <div class="flex gap-2 md:gap-2.5">
            <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="grid h-8 w-8 place-items-center rounded-full border border-white/15 text-white/70 transition-colors duration-200 hover:border-amber-700 hover:bg-amber-700/10 hover:text-white md:h-9 md:w-9">
              <i class="fa-brands fa-facebook-f text-sm md:text-base" aria-hidden="true"></i>
            </a>
            <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="grid h-8 w-8 place-items-center rounded-full border border-white/15 text-white/70 transition-colors duration-200 hover:border-solar-yellow hover:bg-solar-yellow/10 hover:text-solar-yellow md:h-9 md:w-9">
              <i class="fa-brands fa-instagram text-sm md:text-base" aria-hidden="true"></i>
            </a>
            <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="grid h-8 w-8 place-items-center rounded-full border border-white/15 text-white/70 transition-colors duration-200 hover:border-solar-blue hover:bg-solar-blue/20 hover:text-white md:h-9 md:w-9">
              <i class="fa-brands fa-linkedin-in text-sm md:text-base" aria-hidden="true"></i>
            </a>
            <a href="https://youtube.com" target="_blank" rel="noopener noreferrer" aria-label="YouTube" class="grid h-8 w-8 place-items-center rounded-full border border-white/15 text-white/70 transition-colors duration-200 hover:border-amber-700 hover:bg-amber-700/10 hover:text-amber-700 md:h-9 md:w-9">
              <i class="fa-brands fa-youtube text-sm md:text-base" aria-hidden="true"></i>
            </a>
          </div>
        </div>
      </div>

      <!-- Column 2: Navigation Links -->
      <nav aria-labelledby="footer-col-nav">
        <h2 id="footer-col-nav" class="text-[0.7rem] font-semibold uppercase tracking-[0.18em] text-solar-yellow md:text-[0.75rem]">
          {{ footer.navigationTitle }}
        </h2>
        <ul class="-my-1 mt-3 space-y-0 md:-my-1.5 md:mt-4 md:space-y-1">
          <li>
            <a class="inline-flex min-h-6 items-center py-1 text-sm text-white/75 transition-colors duration-200 hover:text-solar-yellow md:py-1.5 md:text-[0.95rem]" href="{{ homeUrl }}#how-it-works">{{ nav.howItWorks }}</a>
          </li>
          <li>
            <a class="inline-flex min-h-6 items-center py-1 text-sm text-white/75 transition-colors duration-200 hover:text-solar-yellow md:py-1.5 md:text-[0.95rem]" href="{{ homeUrl }}#benefits">{{ nav.benefits }}</a>
          </li>
          <li>
            <a class="inline-flex min-h-6 items-center py-1 text-sm text-white/75 transition-colors duration-200 hover:text-solar-yellow md:py-1.5 md:text-[0.95rem]" href="{{ homeUrl }}#projects">{{ nav.projects }}</a>
          </li>
          <li>
            <a class="inline-flex min-h-6 items-center py-1 text-sm text-white/75 transition-colors duration-200 hover:text-solar-yellow md:py-1.5 md:text-[0.95rem]" href="{{ homeUrl }}#audit-form-section">{{ nav.cta }}</a>
          </li>
        </ul>
      </nav>

      <!-- Column 3: Contact Info -->
      <div>
        <h2 class="text-[0.7rem] font-semibold uppercase tracking-[0.18em] text-solar-yellow md:text-[0.75rem]">
          {{ footer.contactTitle }}
        </h2>
        <ul class="mt-3 space-y-2 text-sm md:mt-4 md:space-y-3 md:text-[0.95rem]">
          <li>
            <a href="tel:+905000000000" class="inline-flex min-h-6 items-center text-base font-bold text-white transition-colors duration-200 hover:text-solar-yellow md:text-[1.15rem]">
              +90 500 000 0000
            </a>
          </li>
          <li>
            <a href="mailto:info@solar4turkey.com" class="inline-flex min-h-6 items-center break-all text-white/75 transition-colors duration-200 hover:text-solar-yellow">
              info@solar4turkey.com
            </a>
          </li>
          <li class="text-white/80">
            {{ footer.address }}
          </li>
          <li class="text-white/80">
            {{ footer.hours }}
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Bar / Copyright -->
    <div class="mt-10 flex flex-col items-center justify-between gap-3 border-t border-white/10 py-5 sm:flex-row md:mt-14 md:gap-4 md:py-7">
      <div class="text-xs text-white/70 md:text-sm">
        {{ footer.copyright }}
      </div>
      <nav aria-label="Legal Information" class="-my-2 flex flex-col items-center gap-0.5 text-xs font-medium text-white/70 sm:flex-row sm:gap-4 md:gap-1 md:text-sm">
        <a class="inline-flex items-center px-2 py-1.5 transition-colors duration-200 hover:text-solar-yellow md:py-2" href="/privacy-policy">{{ footer.privacy }}</a>
        <a class="inline-flex items-center px-2 py-1.5 transition-colors duration-200 hover:text-solar-yellow md:py-2" href="/cookie-policy">{{ footer.cookies }}</a>
        <a class="inline-flex items-center px-2 py-1.5 transition-colors duration-200 hover:text-solar-yellow md:py-2" href="/terms">{{ footer.terms }}</a>
      </nav>
    </div>

  </div>
</footer>