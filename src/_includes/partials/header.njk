{%- set homeUrl = "/en/" -%}
{%- if page.url.startsWith('/ru/') -%}
  {%- set homeUrl = "/ru/" -%}
{%- elif page.url.startsWith('/tr/') -%}
  {%- set homeUrl = "/tr/" -%}
{%- endif -%}

{%- set solutionLinks = [
  { label: nav.forComplex,     href: "#for-complex" },
  { label: nav.forBusiness,    href: "#for-business" },
  { label: nav.forVillas,      href: "#for-villas" },
  { label: nav.forApartments,  href: "#for-apartments" }
] -%}

<header class="fixed inset-x-0 top-0 z-10000 h-14 w-full bg-linear-to-b from-black/90 via-black/60 via-80% to-black/40 transition-all duration-300 border-b-dark-slate/20 lg:z-50">
  <nav class="mx-auto flex h-full w-full items-center justify-between gap-2 px-3 md:px-6" aria-label="Main menu">

    <!-- Left Section: Logo Image & Logo Text -->
    <div class="flex shrink-0 items-center gap-2">
      <a aria-label="Solar4Turkey — Home" class="group flex shrink-0 items-center gap-2" href="{{ homeUrl }}#">
        <!-- Logo Text Image -->
        <img src="/assets/img/logo_text_transparent.png" alt="Solar4Turkey" class="h-10 w-auto object-contain"/>
      </a>
    </div>

    <!-- Middle Section: Main Navigation Links -->
    <div class="hidden min-w-0 flex-1 lg:block">
      <div class="flex items-center justify-center gap-1 xl:gap-2">

        <!-- Solutions dropdown (desktop) -->
        <div class="group relative">
          <button type="button" aria-haspopup="menu" class="inline-flex items-center gap-1.5 whitespace-nowrap rounded-lg bg-solar-yellow/10 px-3 py-2.5 text-[0.88rem] font-bold leading-none text-solar-yellow ring-1 ring-solar-yellow/60 transition-all duration-200 group-hover:bg-solar-yellow group-hover:text-dark-slate group-hover:ring-transparent group-focus-within:bg-solar-yellow group-focus-within:text-dark-slate group-focus-within:ring-transparent focus-visible:outline-none active:scale-[0.98] 2xl:px-4 2xl:text-[0.9rem]" >
            <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-solar-yellow transition-colors duration-200 group-hover:bg-dark-slate group-focus-within:bg-dark-slate" aria-hidden="true"></span>
            <span>{{ nav.solutions }}</span>
            <i class="fa-solid fa-chevron-down text-[0.6rem] transition-transform duration-200 group-hover:rotate-180 group-focus-within:rotate-180" aria-hidden="true"></i>
          </button>

          <!-- Dropdown panel -->
          <div role="menu" class="invisible absolute left-0 top-full z-50 w-64 translate-y-2 pt-3 opacity-0 transition-all duration-200 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100" >
            <div class="overflow-hidden rounded-2xl bg-linear-to-b from-black/90 via-black/60 via-80% to-black/40 p-2 shadow-2xl ring-1 ring-white/20 backdrop-blur-md">
              {% for link in solutionLinks %}
                <a role="menuitem" href="{{ homeUrl }}{{ link.href }}" class="group/item flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-semibold text-white/90 transition-colors duration-200 hover:bg-white/10 hover:text-white focus-visible:bg-white/10 focus-visible:text-white focus-visible:outline-none" >
                  <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-solar-yellow transition-transform duration-200 group-hover/item:scale-125" aria-hidden="true"></span>
                  <span class="flex-1">{{ link.label }}</span>
                  <svg viewBox="0 0 16 16" class="h-3 w-3 -ml-1 opacity-0 transition-all duration-200 group-hover/item:ml-0 group-hover/item:opacity-100" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M4.5 11.5 11.5 4.5M6 4.5h5.5V10"></path>
                  </svg>
                </a>
                {% if not loop.last %}
                  <span class="mx-3 my-0.5 block h-px bg-white/10" aria-hidden="true"></span>
                {% endif %}
              {% endfor %}
            </div>
          </div>
        </div>

        <span class="h-3.5 w-px shrink-0 bg-white/20" aria-hidden="true"></span>
        <a class="whitespace-nowrap rounded-lg px-2.5 py-1.5 text-sm font-semibold text-white/90 transition-colors duration-200 hover:bg-white/10 hover:text-white" href="{{ homeUrl }}#how-it-works">{{ nav.howItWorks }}</a>

        <span class="h-3.5 w-px shrink-0 bg-white/20" aria-hidden="true"></span>
        <a class="whitespace-nowrap rounded-lg px-2.5 py-1.5 text-sm font-semibold text-white/90 transition-colors duration-200 hover:bg-white/10 hover:text-white" href="{{ homeUrl }}#benefits">{{ nav.benefits }}</a>

        <span class="h-3.5 w-px shrink-0 bg-white/20" aria-hidden="true"></span>
        <a class="whitespace-nowrap rounded-lg px-2.5 py-1.5 text-sm font-semibold text-white/90 transition-colors duration-200 hover:bg-white/10 hover:text-white" href="{{ homeUrl }}#projects">{{ nav.projects }}</a>

      </div>
    </div>

    <!-- Right Section: Language Switcher, Phone & CTA -->
    <div class="hidden shrink-0 items-center gap-3 lg:flex">

      <!-- Language Switcher (Desktop) -->
      <div class="flex items-center rounded-lg bg-white/10 p-0.5 ring-1 ring-white/20 text-xs font-semibold text-white">
        <a href="/en{{ cleanPath }}" aria-label="English" title="English" class="rounded-md px-2 py-1 text-base leading-none transition-colors {% if not page.url.startsWith('/ru/') and not page.url.startsWith('/tr/') %}bg-solar-yellow text-dark-slate{% else %}hover:bg-white/10 text-white/80{% endif %}">🇬🇧</a>
        <a href="/tr{{ cleanPath }}" aria-label="Türkçe" title="Türkçe" class="rounded-md px-2 py-1 text-base leading-none transition-colors {% if page.url.startsWith('/tr/') %}bg-solar-yellow text-dark-slate{% else %}hover:bg-white/10 text-white/80{% endif %}">🇹🇷</a>
        <a href="/ru{{ cleanPath }}" aria-label="Русский" title="Русский" class="rounded-md px-2 py-1 text-base leading-none transition-colors {% if page.url.startsWith('/ru/') %}bg-solar-yellow text-dark-slate{% else %}hover:bg-white/10 text-white/80{% endif %}">🇷🇺</a>
      </div>

      <a href="tel:+905000000000" class="flex items-center gap-1.5 whitespace-nowrap rounded-lg px-3 py-1.5 text-sm font-semibold text-white ring-1 ring-white/30 transition-colors hover:bg-white/10">
        <span class="inline-flex items-center justify-center">
          <i class="fa-solid fa-phone text-solar-yellow leading-none" aria-hidden="true"></i>
        </span>
        <span>+90 500 000 0000</span>
      </a>

      <a class="whitespace-nowrap rounded-lg bg-solar-yellow px-3.5 py-1.5 text-sm font-bold text-dark-slate shadow-[0_0_14px_2px_rgba(250,204,21,0.45)] transition-all hover:bg-solar-yellow/90 hover:shadow-[0_0_20px_4px_rgba(250,204,21,0.7)]" href="{{ homeUrl }}#audit-form-section">
        {{ nav.cta }}
      </a>
    </div>

    <!-- Mobile Menu Toggle Button -->
    <div class="flex items-center lg:hidden">
      <button id="mobile-menu-btn" type="button" aria-label="Toggle Menu" aria-expanded="false" class="grid h-9 w-9 place-items-center rounded-lg bg-white/10 text-white ring-1 ring-white/30 backdrop-blur-sm transition-colors hover:bg-white/20">
        <span id="menu-icon-open-wrap" class="items-center justify-center">
          <i id="menu-icon-open" class="fa-solid fa-bars text-lg leading-none transition-transform duration-200" aria-hidden="true"></i>
        </span>
        <span id="menu-icon-close-wrap" class="hidden items-center justify-center">
          <i id="menu-icon-close" class="fa-solid fa-xmark text-lg leading-none transition-transform duration-200" aria-hidden="true"></i>
        </span>
      </button>
    </div>
  </nav>

  <!-- Mobile Collapsible Menu Container with Smooth Height Animation -->
  <div id="mobile-menu" class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-in-out lg:hidden">
    <div class="overflow-hidden bg-white">
      <div class="flex flex-col space-y-3 px-4 py-4">

        <!-- Language Switcher (Mobile) -->
        <div class="flex items-center justify-center gap-2 rounded-lg bg-slate-100 p-1 text-sm font-semibold text-dark-slate">
          <a href="/en{{ cleanPath }}" aria-label="English" title="English" class="flex-1 rounded-md py-1.5 text-center text-xl leading-none transition-colors {% if not page.url.startsWith('/ru/') and not page.url.startsWith('/tr/') %}bg-dark-slate text-white{% else %}hover:bg-slate-200{% endif %}">🇬🇧</a>
          <a href="/tr{{ cleanPath }}" aria-label="Türkçe" title="Türkçe" class="flex-1 rounded-md py-1.5 text-center text-xl leading-none transition-colors {% if page.url.startsWith('/tr/') %}bg-dark-slate text-white{% else %}hover:bg-slate-200{% endif %}">🇹🇷</a>
          <a href="/ru{{ cleanPath }}" aria-label="Русский" title="Русский" class="flex-1 rounded-md py-1.5 text-center text-xl leading-none transition-colors {% if page.url.startsWith('/ru/') %}bg-dark-slate text-white{% else %}hover:bg-slate-200{% endif %}">🇷🇺</a>
        </div>

        <!-- Action items -->
        <a href="tel:+905000000000" class="flex items-center justify-center gap-2 rounded-lg border border-slate-200 py-2.5 text-base font-semibold text-dark-slate transition-colors hover:bg-slate-100">
          <span class="inline-flex items-center justify-center">
            <i class="fa-solid fa-phone text-solar-yellow leading-none" aria-hidden="true"></i>
          </span>
          <span>+90 500 000 0000</span>
        </a>
        <a class="block w-full rounded-lg bg-solar-yellow py-2.5 text-center font-bold text-dark-slate transition-colors hover:bg-solar-yellow/90" href="{{ homeUrl }}#audit-form-section">
          {{ nav.cta }}
        </a>

        <hr class="my-1 border-slate-200"/>

        <!-- Solutions group (mobile) -->
        <div class="flex flex-col">
          <span class="px-3 pb-1 pt-2 text-xs font-bold uppercase tracking-wider text-slate-500">{{ nav.solutions }}</span>
          {% for link in solutionLinks %}
            <a class="rounded-lg py-2 pl-6 pr-3 text-base font-medium text-dark-slate hover:bg-slate-100" href="{{ homeUrl }}{{ link.href }}">{{ link.label }}</a>
          {% endfor %}
        </div>

        <!-- Navigation Links -->
        <a class="rounded-lg px-3 py-2 text-base font-medium text-dark-slate hover:bg-slate-100" href="{{ homeUrl }}#how-it-works">{{ nav.howItWorks }}</a>
        <a class="rounded-lg px-3 py-2 text-base font-medium text-dark-slate hover:bg-slate-100" href="{{ homeUrl }}#benefits">{{ nav.benefits }}</a>
        <a class="rounded-lg px-3 py-2 text-base font-medium text-dark-slate hover:bg-slate-100" href="{{ homeUrl }}#projects">{{ nav.projects }}</a>
      </div>
    </div>
  </div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const mobileBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('menu-icon-open-wrap');
    const iconClose = document.getElementById('menu-icon-close-wrap');

    const closeMobileMenu = () => {
      mobileBtn?.setAttribute('aria-expanded', 'false');
      mobileMenu?.classList.remove('grid-rows-[1fr]');
      mobileMenu?.classList.add('grid-rows-[0fr]');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    };

    mobileBtn?.addEventListener('click', () => {
      const isExpanded = mobileBtn.getAttribute('aria-expanded') === 'true';
      mobileBtn.setAttribute('aria-expanded', !isExpanded);

      if (!isExpanded) {
        mobileMenu.classList.remove('grid-rows-[0fr]');
        mobileMenu.classList.add('grid-rows-[1fr]');
        iconOpen.classList.add('hidden');
        iconClose.classList.remove('hidden');
      } else {
        mobileMenu.classList.remove('grid-rows-[1fr]');
        mobileMenu.classList.add('grid-rows-[0fr]');
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
      }
    });

    mobileMenu?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeMobileMenu);
    });
  });
</script>